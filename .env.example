# DreamFactory Configuration
# Your DreamFactory instance URL (without /api/v2)
DREAM_FACTORY_BASE_URL=https://your-instance.dreamfactory.com

# Your DreamFactory API Key
# Create one in DreamFactory Admin → Apps → Create New App
DREAM_FACTORY_API_KEY=your-dreamfactory-api-key-here

# Optional: Arcade Configuration
# Your Arcade API key (if using Arcade Cloud)
# ARCADE_API_KEY=your-arcade-api-key-here

# Optional: Override default service names
# DEFAULT_DATABASE_SERVICE=mysql_prod
# DEFAULT_STORAGE_SERVICE=local